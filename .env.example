# pi-fusion requires at minimum DEEPSEEK_API_KEY (one model) for basic usage.
# For full 3-model panel + judge, set all four:

DEEPSEEK_API_KEY=     # from platform.deepseek.com
MINIMAX_API_KEY=      # from platform.minimax.io
OPENROUTER_API_KEY=   # from openrouter.ai/keys
EXA_API_KEY=          # from dashboard.exa.ai (free tier: 100 searches/mo)
