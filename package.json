{
  "name": "pi-fusion",
  "version": "1.0.0",
  "description": "Multi-model deliberation for pi — fans out queries to 3+ AI models with web search, then a judge synthesizes structured analysis. Matches OpenRouter Fusion architecture at ~$0.01/query.",
  "type": "module",
  "keywords": [
    "pi-package",
    "fusion",
    "multi-model",
    "deliberation",
    "ai-engineering",
    "llm-tools"
  ],
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "bin": {
    "pi-fusion": "./src/cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fusion": "tsx src/cli.ts"
  }
}
